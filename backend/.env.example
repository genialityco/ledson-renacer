# Copiar este archivo a `.env` (o `env`) y completar los valores reales.
# No commitear el archivo con los valores reales.

# Puerto del servidor. DigitalOcean App Platform inyecta PORT automáticamente.
PORT=5000

# --- Firebase Admin SDK ---
# Opción A (recomendada para producción / DO App Platform): pegar aquí el JSON
# del service account codificado en base64. En PowerShell:
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("sured-883e9-firebase-adminsdk.json"))
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Opción B (desarrollo local): si FIREBASE_SERVICE_ACCOUNT_BASE64 no está seteada,
# se lee el archivo sured-883e9-firebase-adminsdk.json en la raíz de backend/.
FIREBASE_STORAGE_BUCKET=

# --- CORS ---
# Lista de orígenes permitidos separados por coma (ej: https://mi-sitio.netlify.app).
# Si se deja vacío, CORS queda abierto (solo recomendado en desarrollo local).
ALLOWED_ORIGINS=

# --- Frontend ---
# URL pública del frontend, usada para armar el enlace de "consultar mi reserva"
# (/my-bookings?code=...) en el correo que se envía al confirmar la foto.
# Si no está seteada, usa http://localhost:5173 (dev).
FRONTEND_URL=

# --- Backend (self) ---
# URL pública del propio backend, usada para armar el link de descarga forzada
# del recuerdo (foto/video) en el correo de resultado.
# Si no está seteada, usa http://localhost:5000 (dev, mismo puerto que PORT).
BACKEND_URL=

# --- API externa de generación de imágenes con IA ---
# Si no está seteada, usa http://localhost:8000. Si falla, se intenta con Gemini
# (ver abajo) y si Gemini también falla, se proyecta la foto original.
AI_GENERATION_API_URL=

# --- Gemini (alternativa si falla AI_GENERATION_API_URL) ---
# Usa las dos imágenes de referencia de cada filtro (referenceImageUrl1/2) más la
# foto de la persona para generar una imagen siguiendo ese estilo de arte.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-image

# --- dLocal Go ---
DLOCALGO_API_KEY=
DLOCALGO_API_SECRET=
# "production" o "sandbox" (default: sandbox)
DLOCALGO_ENV=sandbox

# --- Wompi ---
# "production" o "sandbox" (default: sandbox)
WOMPI_ENV=sandbox
WOMPI_PRIVATE_KEY_TEST=
WOMPI_PRIVATE_KEY_PROD=
WOMPI_INTEGRITY_SECRET_TEST=
WOMPI_INTEGRITY_SECRET_PROD=

# --- AWS SES (envío de emails) ---
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_EMAIL_FROM=
AWS_SES_EMAIL_FROM_NAME=

# --- WhatsApp ---
# URL pública del servicio que envía mensajes de WhatsApp.
WHATSAPP_API_URL=
WHATSAPP_ACCOUNT_ID=

# Peso máximo (MB) de un video subido por el usuario. Debe coincidir con
# VITE_MAX_VIDEO_MB del frontend. Default 200.
MAX_VIDEO_MB=

# Moderación de fotos y videos. MODERATION_PROVIDER = sightengine (default) o
# vision (Google Cloud Vision).
MODERATION_PROVIDER=
# MODERATION_VIDEO_ENABLED=false desactiva solo la moderación de video (las
# fotos se siguen moderando). MODERATION_VIDEO_FRAME_INTERVAL = segundos entre
# fotogramas analizados por clip (default 1). Se aceptan también los nombres
# viejos SIGHTENGINE_VIDEO_ENABLED / SIGHTENGINE_VIDEO_FRAME_INTERVAL.
MODERATION_VIDEO_ENABLED=
MODERATION_VIDEO_FRAME_INTERVAL=
# Umbrales opcionales (0 a 1): MODERATION_WEAPON_THRESHOLD y
# MODERATION_DRUG_THRESHOLD (ambos proveedores), MODERATION_SEXUAL_THRESHOLD
# (solo Sightengine).

# Sightengine: sin estas llaves la moderación queda desactivada. Opcional:
# SIGHTENGINE_MODELS (default nudity-2.1,weapon,alcohol,recreational_drug,medical;
# solo se evalúan nudity, weapon y recreational_drug).
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# Google Cloud Vision: usa la cuenta de servicio de Firebase Admin (no lleva
# llaves propias). Requiere habilitar la "Cloud Vision API" en el proyecto de
# Google Cloud. Opcionales: VISION_SEXUAL_LIKELIHOOD (POSSIBLE, LIKELY o
# VERY_LIKELY; default LIKELY), VISION_WEAPON_LABELS y VISION_DRUG_LABELS
# (etiquetas separadas por coma que cuentan como arma / droga).
VISION_SEXUAL_LIKELIHOOD=

# Llave de la pantalla gigante: se abre como /screen?key=<SCREEN_KEY> y es lo
# único que le permite completar proyecciones (/complete) sin iniciar sesión.
# Sin ella, las proyecciones nunca se completan (no salen correo ni WhatsApp).
# Generar con: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SCREEN_KEY=
